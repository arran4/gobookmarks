-- in.txt --
## File preamble
Tab: Work ## Tab comment
Page: Main ## Page comment
Column: Daily ## Column comment
Category: Development ## Category comment
https://example.com/path\##literal Example \## literal ## Entry comment
## Between entries
https://github.com GitHub
## Before next category
Category: Reference
https://example.org Reference
-- ## Separator comment
## After separator
Column: Archive
Category: Old
https://old.example Old
## EOF comment
-- test.go --
package main

import (
	"testing"
	"strings"
	"github.com/arran4/gobookmarks"
)

func TestParseParityComments(t *testing.T) {
	input := `## File preamble
Tab: Work ## Tab comment
Page: Main ## Page comment
Column: Daily ## Column comment
Category: Development ## Category comment
https://example.com/path\##literal Example \## literal ## Entry comment
## Between entries
https://github.com GitHub
## Before next category
Category: Reference
https://example.org Reference
-- ## Separator comment
## After separator
Column: Archive
Category: Old
https://old.example Old
## EOF comment`

	bl1 := gobookmarks.ParseBookmarks(input)
	bl2, err := gobookmarks.StrictParseBookmarks(input)
	if err != nil {
		t.Fatalf("strict parse failed: %v", err)
	}

	if bl1.String() != bl2.String() {
		t.Fatalf("parsers are not equivalent:\nParse:\n%v\n\nStrictParse:\n%v", bl1.String(), bl2.String())
	}

	// Verify JSON mapping
	j1 := bl1.ToJSON()
	j2 := bl2.ToJSON()

	bl3 := gobookmarks.BookmarkListFromJSON(j1)
	if bl3.String() != bl1.String() {
		t.Fatalf("JSON roundtrip failed:\nOriginal:\n%v\n\nRoundtrip:\n%v", bl1.String(), bl3.String())
	}

	// Verify escaping decoded properly
	e1 := bl1[0].Pages[0].Blocks[0].Columns[0].Categories[0].Entries[0]
	if e1.Url != "https://example.com/path##literal" {
		t.Errorf("Url escaping wrong: %v", e1.Url)
	}
	if e1.Name != "Example ## literal" {
		t.Errorf("Name escaping wrong: %v", e1.Name)
	}
	if e1.InlineComment != " Entry comment" {
		t.Errorf("Inline comment wrong: %v", e1.InlineComment)
	}
}
